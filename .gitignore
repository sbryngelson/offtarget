corpus/
spec/
results/
# a worktree links these three to the shared directories; "dir/" matches directories only, so
# the links need the patterns without a trailing slash (a tracked link replaces the directory on merge)
/corpus
/spec
/results
.superpowers/
# the site built by tools/site_publish.sh _site (docs/tooling/publishing.md)
/_site/
__pycache__/
.pytest_cache/
*.pyc
*.core

# core dumps
*.core

# offload data built from a checkout
.offload-cache/

# the version hatch-vcs writes at build time (pyproject.toml)
/offload/_version.py

# per-user settings for the machines and compilers (catalog/local.example.yaml)
/catalog/local.yaml

# the paths the maintainers' private checkout supplies, linked here by tools/repo/link_private.py
# (tools/repo/private.yaml); no trailing slash, so the links match too
/data/bench/*
!/data/bench/README.md
/data/vendor/amd
/data/vendor/hpe
/data/vendor/nvidia
/data/vendor/errata-for-findings.md
/data/vendor/checks/reports-*.yaml
/data/vendor/checks/reports.json
/data/findings/LOG.md
